# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# AI features (hints, coach, /stats analysis, Smart select, similar problems).
# Chat and embeddings pick their provider independently: "openrouter" (hosted,
# needs a key) or "ollama" (local, no key). See README "Running AI locally".
AI_PROVIDER="openrouter"           # hints, coach, stats analysis, Smart select re-rank
EMBEDDING_PROVIDER="openrouter"    # pnpm embed, similar problems, Smart select retrieval

# --- OpenRouter (https://openrouter.ai/keys) ---
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-6-luna"

# --- Ollama (https://ollama.com) — used when a provider above is "ollama" ---
# Native API base URL (note the /api suffix).
OLLAMA_BASE_URL="http://localhost:11434/api"
# Chat model: `ollama pull qwen3:8b`
OLLAMA_MODEL="qwen3:8b"
# Embedding model: `ollama pull embeddinggemma`. Re-run `pnpm embed` after changing it.
OLLAMA_EMBEDDING_MODEL="embeddinggemma"
# Context window in tokens. Ollama's own default is small and silently truncates
# the long /stats and Smart select prompts, so this is set generously.
OLLAMA_NUM_CTX="16384"
# Sampling temperature; blank = the model's default.
OLLAMA_TEMPERATURE=""
# "Thinking" for reasoning models (qwen3, deepseek-r1, ...). Coach/hints default
# to off for speed; analysis/Smart select blank = model default. true | false.
OLLAMA_COACH_THINK="false"
OLLAMA_ANALYSIS_THINK=""
# Any other native Ollama option as a JSON object, e.g. {"top_k":40,"repeat_penalty":1.1}
OLLAMA_OPTIONS=""

# Desmos graphing + scientific calculator, embedded in the practice runner.
# Get a free key at https://www.desmos.com/api — the Desmos-hosted demo key
# is rate-limited and not meant for real deployments. Public (NEXT_PUBLIC_)
# because the calculator loads client-side.
NEXT_PUBLIC_DESMOS_API_KEY=""
