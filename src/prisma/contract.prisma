// use prisma-8

// ─── College Board Question Bank ────────────────────────────────────────────
// Scraped from the College Board educator Question Bank (SAT + PSAT/NMSQT &
// PSAT 10 — see ATTRIBUTION.md). Two-table split:
//
//   Question            one row per unique question (content), keyed by its
//                       natural id: external_id when present, else ibn.
//   QuestionAssessment  one row per (assessment × question) placement. This
//                       metadata is NOT question-scoped — `difficulty` and
//                       `scoreBand` diverge between the SAT and PSAT banks for
//                       the same question, so they cannot live on Question.
//
// No column-level @map: field name == column name, so the db.orm lane (field
// names) and the db.sql lane (storage column names) share one vocabulary.
// Tables ARE @@map'd to snake_case for a friendlier psql experience.
//
// Timestamp fields use TimestamptzString, not DateTime/Timestamptz: Node
// 26.8.1 (the version this repo runs on) has no globalThis.Temporal, and the
// Temporal-backed codecs throw RUNTIME.TEMPORAL_UNAVAILABLE on first read or
// write. TimestamptzString is a pass-through to the same `timestamptz`
// column — switch types later (with temporal-polyfill) without a migration.

model Question {
  // external_id (UUID) when present, else ibn ("022222-DC"). The two formats
  // are disjoint, so the natural key needs no prefix.
  id         String  @id
  externalId String? @unique
  ibn        String? @unique

  contentSource String // 'qbank' (POST /get-question) | 'saic' (disclosed/{ibn}.json)
  type          String // 'mcq' | 'spr'

  stem      String
  stimulus  String?
  rationale String?

  // MCQ: [{ id, content, letter }]. NULL for spr.
  answerOptions Jsonb?
  // Raw `keys`. MCQ: answerOption ids. SPR: the accepted literal answer(s).
  correctKeys   String[]
  // Raw `correct_answer`. MCQ: ["B"]. SPR: ["403"].
  correctAnswer String[]

  // Promoted optional detail keys — present on roughly two-thirds of qbank
  // items, absent from the rest and from every saic item. Nullable by nature.
  vaultId             String?
  origin              String?
  templateClusterId   String?
  templateClusterName String?
  parentTemplateId    String?
  parentTemplateName  String?
  positionIndex       Int? // upstream key is `position`; avoided as a column name

  // Verbatim detail payload. The key set varies per item — this is what
  // guarantees "retain full info" holds even when the shape drifts.
  raw         Jsonb
  contentHash String // sha256 of the canonicalized raw payload; cheap change detection

  // True when stem/stimulus/rationale/answerOptions still embed a base64
  // <img class="math-img"> after normalization. Only possible for
  // contentSource='saic': College Board's disclosed-item format renders some
  // equations as pre-rendered images with no alt-text description at all, so
  // there is no text to substitute and the image is kept rather than the
  // content silently dropped. contentSource='qbank' items carry real MathML
  // and are never affected.
  hasEmbeddedMathImages Boolean @default(false)

  fetchedAt TimestamptzString @default(now())

  placements QuestionAssessment[]
  setItems   PracticeSetItem[]
  attempts   Attempt[]
  hints      QuestionHint[]
  embeddings QuestionEmbedding[]

  @@map("question")
  @@index([type])
  @@index([contentSource])
}

model QuestionAssessment {
  assessment String // 'SAT' | 'PSAT/NMSQT & PSAT 10'
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  asmtEventId Int // 99 | 100
  program     String // row.program: 'SAT' | 'P10'
  section     Int // 1 = Reading and Writing, 2 = Math
  sectionCode String // 'RW' | 'MATH'

  domainCode String // primary_class_cd: INI CAS EOI SEC H P Q S
  domainDesc String // primary_class_cd_desc
  skillCode  String // skill_cd
  skillDesc  String // skill_desc, normalized (upstream casing is inconsistent)

  difficulty String // 'E' | 'M' | 'H' — assessment-scoped; the whole reason for the split
  scoreBand  Int? // score_band_range_cd, 1-7

  bankQuestionId String // upstream `questionId` — bank-local 8-hex, NOT the join key
  uId            String?
  pPcc           String? // e.g. "SAT#INI"

  createDate TimestamptzString?
  updateDate TimestamptzString?

  listRaw Jsonb // verbatim list row

  @@id([assessment, questionId])
  @@map("question_assessment")
  @@index([questionId])
  @@index([assessment, section, domainCode, skillCode], name: "qa_asmt_section_domain_skill")
  @@index([assessment, difficulty])
  @@index([bankQuestionId])
}

// Vector representation of a question's content, for "View similar problems"
// (src/lib/query/similar-questions.ts). Shared across profiles like
// QuestionHint — it's derived from Question content, not user history, so
// `pnpm db:reset-users` never touches it. Keyed by (questionId, model,
// textVariant) rather than questionId alone so a future model change is
// additive (old + new vectors coexist for comparison) instead of a wipe.
model QuestionEmbedding {
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  model       String // OpenRouter model id, e.g. 'google/gemini-embedding-2'
  textVariant String // 'full' — stimulus + stem + answer-option text concatenated

  dim         Int
  contentHash String // Question.contentHash at embed time — drives re-embedding on drift
  vector      Bytes  // dim x float32, little-endian, L2-NORMALIZED on write (see embed-questions.ts)

  createdAt TimestamptzString @default(now())

  @@id([questionId, model, textVariant])
  @@map("question_embedding")
  @@index([model, textVariant])
}

// ─── Practice tool ──────────────────────────────────────────────────────────
// Everything below is app-owned state layered on top of the College Board
// data above. PracticeSetItem and Attempt deliberately SNAPSHOT the facet
// values (sectionCode/domainCode/skillCode/difficulty/scoreBand/type) off
// QuestionAssessment at generation/answer time rather than joining live —
// a future `pnpm load` re-run must never retroactively rewrite history.
//
// Same conventions as above: no column-level @map (db.orm field names ==
// db.sql column names), tables @@map'd to snake_case, timestamps are
// TimestamptzString, ids are app-generated (crypto.randomUUID()).

model Profile {
  id         String            @id
  name       String            @unique
  accent     String? // UI accent token, e.g. a tag-color name
  createdAt  TimestamptzString @default(now())
  lastSeenAt TimestamptzString @default(now())

  practiceSets PracticeSet[]
  attempts     Attempt[]
  examSessions ExamSession[]

  @@map("profile")
}

model PracticeSet {
  id        String  @id
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name   String
  status String // 'in_progress' | 'completed' | 'abandoned'
  mode   String // 'practice' (random-sampled drilling) | 'exam' (premade, full-length — see ExamSession)

  // Full generator spec (assessment, sections, difficulties, domains/skills,
  // scoreBands, types, excludeAttempted, length) — replaying/regenerating a
  // set reads only this.
  config Jsonb

  // Denormalized from `config` for cheap list-view filtering without parsing it.
  assessment   String
  sectionCodes String[]
  difficulties String[]

  questionCount Int
  currentIndex  Int @default(0)

  correctCount  Int @default(0)
  gradedCount   Int @default(0)
  totalActiveMs Int @default(0)

  createdAt   TimestamptzString @default(now())
  startedAt   TimestamptzString?
  completedAt TimestamptzString?

  items    PracticeSetItem[]
  attempts Attempt[]

  examSession ExamSession?

  @@map("practice_set")
  @@index([profileId, status])
}

model PracticeSetItem {
  id       String      @id
  setId    String
  set      PracticeSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  position Int

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  assessment String // which QuestionAssessment placement (SAT vs PSAT) this item was generated from

  // Snapshot of QuestionAssessment facets at generation time.
  sectionCode String
  domainCode  String
  skillCode   String
  difficulty  String
  scoreBand   Int?
  type        String
  gradable    Boolean // false when the source question has no published correctAnswer

  attempt Attempt?

  @@unique([setId, position])
  @@map("practice_set_item")
  @@index([questionId])
}

model Attempt {
  id     String          @id
  itemId String          @unique
  item   PracticeSetItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  setId String
  set   PracticeSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // Facet snapshot, denormalized so a future stats screen groups by skill
  // with zero joins.
  assessment    String
  sectionCode   String
  domainCode    String
  skillCode     String
  difficulty    String
  scoreBand     Int?
  type          String
  contentSource String

  // Response
  status           String // 'unanswered' | 'answered' | 'skipped'
  selectedOptionId String?
  selectedLetter   String?
  spResponse       String?
  spNormalized     String?
  isCorrect        Boolean?
  gradable         Boolean

  // Timing
  firstViewedAt       TimestamptzString?
  firstInputAt        TimestamptzString?
  submittedAt         TimestamptzString?
  activeMs            Int @default(0) // visible + focused time only
  totalMs             Int @default(0)
  timeToFirstInputMs  Int?
  timeAfterFeedbackMs Int @default(0) // time spent reading the rationale after submit
  visitCount          Int @default(0)
  answerChangeCount   Int @default(0)

  // Tools
  markedForReview     Boolean  @default(false)
  eliminatedOptionIds String[] @default([])
  eliminationCount    Int      @default(0)
  hintsUsed           Int      @default(0)
  maxHintLevel        Int      @default(0)
  answerRevealed      Boolean  @default(false) // gave up and used "Reveal answer" — scored wrong
  calculatorOpened    Boolean  @default(false)
  calculatorOpenMs    Int      @default(0)
  referenceOpened     Boolean  @default(false)
  highlightCount      Int      @default(0)
  highlights          Jsonb? // [{ start, end, text, color, createdAt }]
  notes               String?
  chatMessages        Jsonb? // post-answer coach chat: [{ role, content }] — reset on "Clear chat"

  events AttemptEvent[]
  hints  AttemptHint[]

  @@map("attempt")
  @@index([profileId, submittedAt])
  @@index([profileId, skillCode])
  @@index([profileId, questionId])
  @@index([setId])
}

model AttemptEvent {
  id        String  @id
  attemptId String
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  // Denormalized for querying the event stream without joining back to Attempt.
  profileId  String
  setId      String
  questionId String

  seq Int // monotonic per attempt, assigned client-side — the idempotency key

  type     String // view_enter | view_exit | focus | blur | select_option | change_option |
  // eliminate_option | restore_option | mark_review | hint_request | hint_shown |
  // calc_open | calc_close | reference_open | highlight_add | highlight_remove |
  // note_save | submit | reveal_feedback | nav_next | nav_prev | nav_jump |
  // set_start | set_complete | reveal_answer | coach_open | coach_message
  atMs     Int // ms since attempt start, client clock
  clientAt TimestamptzString

  payload Jsonb?

  @@unique([attemptId, seq])
  @@map("attempt_event")
  @@index([attemptId])
}

// AI hint cache — shared across profiles so a given (question, level) is
// generated once, not once per profile.
model QuestionHint {
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  level      Int // 1 = nudge, 2 = approach, 3 = near-solution

  content   String
  model     String // OpenRouter model id that generated this hint, for future re-gen/audit
  createdAt TimestamptzString @default(now())

  attemptHints AttemptHint[]

  @@id([questionId, level])
  @@map("question_hint")
}

model AttemptHint {
  id String @id

  attemptId String
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  level      Int
  hint       QuestionHint @relation(fields: [questionId, level], references: [questionId, level], onDelete: Cascade)

  requestedAt TimestamptzString @default(now())

  @@unique([attemptId, questionId, level])
  @@map("attempt_hint")
  @@index([attemptId])
}

// ─── Premade full-length adaptive exams ─────────────────────────────────────
// An exam session IS a PracticeSet with mode='exam'. These two models add
// only what a practice set has no concept of: the module split, the routing
// decision, and the server-authoritative per-module deadline. Every item and
// response still lives in PracticeSetItem/Attempt, so exams inherit the
// whole timing/tool/annotation column set and the AttemptEvent pipeline
// unchanged — see src/exams/ (blueprints), src/lib/exam/ (state helpers),
// and src/actions/exams.ts (the action surface).
//
// ExamSession.id always equals its PracticeSet.id, by convention, not a
// schema constraint — same convention, same reason, as
// Attempt.id === PracticeSetItem.id: this ORM's .upsert() conflict-targets
// the primary key, and it lets /tests/[sessionId] and the existing
// EventBuffer / POST /api/events address one identity with zero changes.
//
// Attempt.status means something different in this mode, deliberately:
//   practice  'answered' means graded AND revealed (isCorrect is set).
//   exam      'answered' means a response exists; isCorrect/submittedAt
//             stay NULL until the module is submitted and graded in bulk.
//   `isCorrect IS NULL AND submittedAt IS NULL` uniquely identifies an
//   in-flight, ungraded exam response.

model ExamSession {
  id String @id

  setId String      @unique
  set   PracticeSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  examId     String // registry key from src/exams/index.ts — NOT a FK; blueprints are committed code, not rows
  assessment String

  phase String // one of EXAM_PHASES (src/lib/exam/phases.ts) — m1_directions .. completed

  // Which physical section occupies slot 1/2 vs slot 3/4 for this session —
  // a 2-element permutation of "RW"/"MATH" chosen by the student at start.
  // Phases are slot-generic (m1..m4); phaseModule() resolves a slot to a
  // section via this array. See src/lib/exam/phases.ts's file comment.
  sectionOrder String[] @default([])
  // Student opted into "take one section now, finish the other later" at
  // start. Never gates a phase transition — copy/labeling only (the break
  // phase already tolerates an arbitrary gap regardless of this flag).
  splitSitting Boolean @default(false)

  // Score snapshot (src/exams/scoring.ts). A section's own 3 fields are
  // written as soon as that section's second module is submitted (so its
  // score can be shown before the other section is done); all 7 are written
  // together again at full completion. Either way, once written they are
  // never recomputed on the results page — so re-tuning a blueprint's scaled
  // table later can never rewrite a completed test's history.
  rwVariant   String? // 'lower' | 'upper'
  rwRaw       Int?
  rwScaled    Int?
  mathVariant String? // 'lower' | 'upper'
  mathRaw     Int?
  mathScaled  Int?
  totalScaled Int?

  breakStartedAt TimestamptzString?
  breakEndsAt    TimestamptzString?

  createdAt   TimestamptzString  @default(now())
  startedAt   TimestamptzString?
  completedAt TimestamptzString?

  modules ExamModule[]

  @@map("exam_session")
  @@index([profileId, examId])
}

model ExamModule {
  id        String      @id
  sessionId String
  session   ExamSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  sectionCode String // 'RW' | 'MATH'
  moduleIndex Int // 1 | 2
  variant     String? // NULL for module 1; 'lower' | 'upper' once module 1 is graded and this module is routed

  status String // 'pending' | 'active' | 'submitted'

  // Half-open range [startPosition, startPosition + itemCount) into
  // PracticeSetItem.position. Fixed for ALL FOUR modules at session
  // creation time — this requires the blueprint's module2Lower and
  // module2Upper id lists to be the same length (see validateBlueprint in
  // src/exams/spec.ts) — which is what lets module-2 PracticeSetItem rows
  // be inserted later, after routing, without renumbering anything.
  startPosition Int
  itemCount     Int
  minutes       Int

  // Server-authoritative timing. deadlineAt is the ONLY expiry truth — the
  // client counts down against it using a server-clock offset, never its
  // own wall clock. Written exactly once, by startModule(), when the
  // student presses Continue on this module's directions screen (never
  // automatically).
  startedAt   TimestamptzString?
  deadlineAt  TimestamptzString?
  submittedAt TimestamptzString?

  rawCorrect    Int?
  answeredCount Int?
  autoSubmitted Boolean @default(false)

  @@unique([sessionId, sectionCode, moduleIndex])
  @@map("exam_module")
  @@index([sessionId, status])
}
