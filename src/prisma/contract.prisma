// use prisma-8

// ─── College Board Question Bank ────────────────────────────────────────────
// Scraped from the College Board educator Question Bank (SAT + PSAT/NMSQT &
// PSAT 10 — see ATTRIBUTION.md). Two-table split:
//
//   Question            one row per unique question (content), keyed by its
//                       natural id: external_id when present, else ibn.
//   QuestionAssessment  one row per (assessment × question) placement. This
//                       metadata is NOT question-scoped — `difficulty` and
//                       `scoreBand` diverge between the SAT and PSAT banks for
//                       the same question, so they cannot live on Question.
//
// No column-level @map: field name == column name, so the db.orm lane (field
// names) and the db.sql lane (storage column names) share one vocabulary.
// Tables ARE @@map'd to snake_case for a friendlier psql experience.
//
// Timestamp fields use TimestamptzString, not DateTime/Timestamptz: Node
// 26.8.1 (the version this repo runs on) has no globalThis.Temporal, and the
// Temporal-backed codecs throw RUNTIME.TEMPORAL_UNAVAILABLE on first read or
// write. TimestamptzString is a pass-through to the same `timestamptz`
// column — switch types later (with temporal-polyfill) without a migration.

model Question {
  // external_id (UUID) when present, else ibn ("022222-DC"). The two formats
  // are disjoint, so the natural key needs no prefix.
  id         String  @id
  externalId String? @unique
  ibn        String? @unique

  contentSource String // 'qbank' (POST /get-question) | 'saic' (disclosed/{ibn}.json)
  type          String // 'mcq' | 'spr'

  stem      String
  stimulus  String?
  rationale String?

  // MCQ: [{ id, content, letter }]. NULL for spr.
  answerOptions Jsonb?
  // Raw `keys`. MCQ: answerOption ids. SPR: the accepted literal answer(s).
  correctKeys   String[]
  // Raw `correct_answer`. MCQ: ["B"]. SPR: ["403"].
  correctAnswer String[]

  // Promoted optional detail keys — present on roughly two-thirds of qbank
  // items, absent from the rest and from every saic item. Nullable by nature.
  vaultId             String?
  origin              String?
  templateClusterId   String?
  templateClusterName String?
  parentTemplateId    String?
  parentTemplateName  String?
  positionIndex       Int? // upstream key is `position`; avoided as a column name

  // Verbatim detail payload. The key set varies per item — this is what
  // guarantees "retain full info" holds even when the shape drifts.
  raw         Jsonb
  contentHash String // sha256 of the canonicalized raw payload; cheap change detection

  // True when stem/stimulus/rationale/answerOptions still embed a base64
  // <img class="math-img"> after normalization. Only possible for
  // contentSource='saic': College Board's disclosed-item format renders some
  // equations as pre-rendered images with no alt-text description at all, so
  // there is no text to substitute and the image is kept rather than the
  // content silently dropped. contentSource='qbank' items carry real MathML
  // and are never affected.
  hasEmbeddedMathImages Boolean @default(false)

  fetchedAt TimestamptzString @default(now())

  placements QuestionAssessment[]
  setItems   PracticeSetItem[]
  attempts   Attempt[]
  hints      QuestionHint[]

  @@map("question")
  @@index([type])
  @@index([contentSource])
}

model QuestionAssessment {
  assessment String // 'SAT' | 'PSAT/NMSQT & PSAT 10'
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  asmtEventId Int // 99 | 100
  program     String // row.program: 'SAT' | 'P10'
  section     Int // 1 = Reading and Writing, 2 = Math
  sectionCode String // 'RW' | 'MATH'

  domainCode String // primary_class_cd: INI CAS EOI SEC H P Q S
  domainDesc String // primary_class_cd_desc
  skillCode  String // skill_cd
  skillDesc  String // skill_desc, normalized (upstream casing is inconsistent)

  difficulty String // 'E' | 'M' | 'H' — assessment-scoped; the whole reason for the split
  scoreBand  Int? // score_band_range_cd, 1-7

  bankQuestionId String // upstream `questionId` — bank-local 8-hex, NOT the join key
  uId            String?
  pPcc           String? // e.g. "SAT#INI"

  createDate TimestamptzString?
  updateDate TimestamptzString?

  listRaw Jsonb // verbatim list row

  @@id([assessment, questionId])
  @@map("question_assessment")
  @@index([questionId])
  @@index([assessment, section, domainCode, skillCode], name: "qa_asmt_section_domain_skill")
  @@index([assessment, difficulty])
  @@index([bankQuestionId])
}

// ─── Practice tool ──────────────────────────────────────────────────────────
// Everything below is app-owned state layered on top of the College Board
// data above. PracticeSetItem and Attempt deliberately SNAPSHOT the facet
// values (sectionCode/domainCode/skillCode/difficulty/scoreBand/type) off
// QuestionAssessment at generation/answer time rather than joining live —
// a future `pnpm load` re-run must never retroactively rewrite history.
//
// Same conventions as above: no column-level @map (db.orm field names ==
// db.sql column names), tables @@map'd to snake_case, timestamps are
// TimestamptzString, ids are app-generated (crypto.randomUUID()).

model Profile {
  id         String            @id
  name       String            @unique
  accent     String? // UI accent token, e.g. a tag-color name
  createdAt  TimestamptzString @default(now())
  lastSeenAt TimestamptzString @default(now())

  practiceSets PracticeSet[]
  attempts     Attempt[]

  @@map("profile")
}

model PracticeSet {
  id        String  @id
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  name   String
  status String // 'in_progress' | 'completed' | 'abandoned'
  mode   String // 'practice' — the only mode implemented today; reserved for a future 'timed'

  // Full generator spec (assessment, sections, difficulties, domains/skills,
  // scoreBands, types, excludeAttempted, length) — replaying/regenerating a
  // set reads only this.
  config Jsonb

  // Denormalized from `config` for cheap list-view filtering without parsing it.
  assessment   String
  sectionCodes String[]
  difficulties String[]

  questionCount Int
  currentIndex  Int @default(0)

  correctCount  Int @default(0)
  gradedCount   Int @default(0)
  totalActiveMs Int @default(0)

  createdAt   TimestamptzString @default(now())
  startedAt   TimestamptzString?
  completedAt TimestamptzString?

  items    PracticeSetItem[]
  attempts Attempt[]

  @@map("practice_set")
  @@index([profileId, status])
}

model PracticeSetItem {
  id       String      @id
  setId    String
  set      PracticeSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  position Int

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  assessment String // which QuestionAssessment placement (SAT vs PSAT) this item was generated from

  // Snapshot of QuestionAssessment facets at generation time.
  sectionCode String
  domainCode  String
  skillCode   String
  difficulty  String
  scoreBand   Int?
  type        String
  gradable    Boolean // false when the source question has no published correctAnswer

  attempt Attempt?

  @@unique([setId, position])
  @@map("practice_set_item")
  @@index([questionId])
}

model Attempt {
  id     String          @id
  itemId String          @unique
  item   PracticeSetItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  setId String
  set   PracticeSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  // Facet snapshot, denormalized so a future stats screen groups by skill
  // with zero joins.
  assessment    String
  sectionCode   String
  domainCode    String
  skillCode     String
  difficulty    String
  scoreBand     Int?
  type          String
  contentSource String

  // Response
  status           String // 'unanswered' | 'answered' | 'skipped'
  selectedOptionId String?
  selectedLetter   String?
  spResponse       String?
  spNormalized     String?
  isCorrect        Boolean?
  gradable         Boolean

  // Timing
  firstViewedAt       TimestamptzString?
  firstInputAt        TimestamptzString?
  submittedAt         TimestamptzString?
  activeMs            Int @default(0) // visible + focused time only
  totalMs             Int @default(0)
  timeToFirstInputMs  Int?
  timeAfterFeedbackMs Int @default(0) // time spent reading the rationale after submit
  visitCount          Int @default(0)
  answerChangeCount   Int @default(0)

  // Tools
  markedForReview     Boolean  @default(false)
  eliminatedOptionIds String[] @default([])
  eliminationCount    Int      @default(0)
  hintsUsed           Int      @default(0)
  maxHintLevel        Int      @default(0)
  calculatorOpened    Boolean  @default(false)
  calculatorOpenMs    Int      @default(0)
  referenceOpened     Boolean  @default(false)
  highlightCount      Int      @default(0)
  highlights          Jsonb? // [{ start, end, text, color, createdAt }]
  notes               String?

  events AttemptEvent[]
  hints  AttemptHint[]

  @@map("attempt")
  @@index([profileId, submittedAt])
  @@index([profileId, skillCode])
  @@index([profileId, questionId])
  @@index([setId])
}

model AttemptEvent {
  id        String  @id
  attemptId String
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  // Denormalized for querying the event stream without joining back to Attempt.
  profileId  String
  setId      String
  questionId String

  seq Int // monotonic per attempt, assigned client-side — the idempotency key

  type     String // view_enter | view_exit | focus | blur | select_option | change_option |
  // eliminate_option | restore_option | mark_review | hint_request | hint_shown |
  // calc_open | calc_close | reference_open | highlight_add | highlight_remove |
  // note_save | submit | reveal_feedback | nav_next | nav_prev | nav_jump |
  // set_start | set_complete
  atMs     Int // ms since attempt start, client clock
  clientAt TimestamptzString

  payload Jsonb?

  @@unique([attemptId, seq])
  @@map("attempt_event")
  @@index([attemptId])
}

// AI hint cache — shared across profiles so a given (question, level) is
// generated once, not once per profile.
model QuestionHint {
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  level      Int // 1 = nudge, 2 = approach, 3 = near-solution

  content   String
  model     String // OpenRouter model id that generated this hint, for future re-gen/audit
  createdAt TimestamptzString @default(now())

  attemptHints AttemptHint[]

  @@id([questionId, level])
  @@map("question_hint")
}

model AttemptHint {
  id String @id

  attemptId String
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  questionId String
  level      Int
  hint       QuestionHint @relation(fields: [questionId, level], references: [questionId, level], onDelete: Cascade)

  requestedAt TimestamptzString @default(now())

  @@unique([attemptId, questionId, level])
  @@map("attempt_hint")
  @@index([attemptId])
}
